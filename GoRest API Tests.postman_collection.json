				{
					"name": "TC_23 - POST create user - data-driven validation",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const csvEmail = pm.iterationData.get(\"email\");",
									"",
									"if (csvEmail) {",
									"    const timestamp = Date.now();",
									"    const uniqueEmail = csvEmail.includes(\"@\") ",
									"        ? csvEmail.replace(\"@\", `${timestamp}@`) ",
									"        : csvEmail;",
									"    pm.environment.set(\"csvTestEmail\", uniqueEmail);",
									"} else {",
									"    console.log(\"No CSV data available - skipping unique email generation\");",
									"    pm.environment.set(\"csvTestEmail\", `fallback${Date.now()}@example.com`);",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"const expectedStatusRaw = pm.iterationData.get(\"expectedStatus\");",
									"",
									"if (expectedStatusRaw) {",
									"    pm.test(\"Status matches expected value from CSV\", function () {",
									"        const expectedStatus = parseInt(expectedStatusRaw);",
									"        pm.expect(pm.response.code).to.equal(expectedStatus);",
									"    });",
									"} else {",
									"    console.log(\"No CSV data - skipping status comparison\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
