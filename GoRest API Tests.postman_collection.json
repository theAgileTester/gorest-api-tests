					"name": "TC_1 - GET users - all users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Save current total pages for dynamic boundary testing\", function () {",
									"    const totalPages = pm.response.headers.get(\"x-pagination-pages\");",
									"    pm.environment.set(\"totalPages\", totalPages);",
									"});",
									"pm.test(\"Save a currently-valid user ID for later tests\", function () {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.length > 5) {",
									"        pm.environment.set(\"currentValidUserId\", jsonData[5].id);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
